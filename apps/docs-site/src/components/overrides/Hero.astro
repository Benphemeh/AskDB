---
/**
 * Starlight Hero override. On the home page it lays out the title, tagline, actions and install
 * command beside the pipeline diagram (`HomeHeroDiagram`). Every other page with a hero (the 404
 * page) gets a centered title and tagline, with the frontmatter image when there is one.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { LinkButton } from "@astrojs/starlight/components";
import HomeCliStrip from "../HomeCliStrip.astro";
import HomeHeroDiagram from "../HomeHeroDiagram.astro";
import { withBase } from "../../utils/links";

const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
/** Root `docs/index.mdx` is normalized to `""`, not `"index"` (see Starlight `normalizeIndexSlug`). */
const routeId = Astro.locals.starlightRoute.id;
const isHome = routeId === "" || routeId === "index" || routeId === "/";

/**
 * The home title is plain text in front matter, so /llms-full.txt and the page's Markdown twin
 * print it as written. Here it gets its two lines and the accent on "NL-to-SQL".
 */
const ACCENT = "NL-to-SQL";
const [beforeAccent, afterAccent] = isHome && title.includes(ACCENT) ? title.split(ACCENT) : [title, undefined];

const imageAttrs = {
	loading: "eager" as const,
	decoding: "async" as const,
	width: 400,
	height: 400,
	alt: image?.alt || "",
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image && !isHome) {
	if ("file" in image) {
		darkImage = image.file;
	} else if ("dark" in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

<div class:list={["hero", { "hero-home": isHome }]}>
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			{isHome && <p class="kicker"><span aria-hidden="true" />Open source · Apache 2.0</p>}
			{
				afterAccent === undefined ? (
					<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
				) : (
					<h1 id={PAGE_TITLE_ID} data-page-title>
						<span class="home-hero-title">
							{beforeAccent}
							<span class="home-hero-accent">{ACCENT}</span>
							<br />
							{afterAccent.trim()}
						</span>
					</h1>
				)
			}
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
						<LinkButton href={withBase(link)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			)
		}
		{isHome && <HomeCliStrip />}
	</div>
	{
		isHome ? (
			<div class="art">
				<HomeHeroDiagram />
			</div>
		) : (
			<>
				{darkImage && (
					<Image src={darkImage} {...imageAttrs} class:list={{ "light:sl-hidden": Boolean(lightImage) }} />
				)}
				{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
				{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
			</>
		)
	}
</div>

<style>
	.hero {
		align-items: center;
		display: grid;
		gap: 2.5rem;
		grid-template-columns: 100%;
		padding-block: 2.5rem 1rem;
	}

	/* The home hero lines up with the sections under it (`.home-landing` in src/styles/home.css). */
	.hero-home {
		margin-inline: auto;
		max-width: 62rem;
	}

	.hero > img,
	.hero > .hero-html {
		height: auto;
		margin-inline: auto;
		object-fit: contain;
		width: min(70%, 20rem);
	}

	.stack {
		align-items: center;
		flex-direction: column;
		gap: 1.75rem;
		text-align: center;
	}

	.copy {
		align-items: center;
		flex-direction: column;
		gap: 1.125rem;
	}

	.copy > * {
		max-width: 34rem;
	}

	.kicker {
		align-items: center;
		background-color: var(--ask-surface);
		border: 1px solid var(--ask-border);
		border-radius: 999px;
		color: var(--ask-text-muted);
		display: inline-flex;
		font-size: 0.75rem;
		font-weight: 500;
		gap: 0.5rem;
		line-height: 1.4;
		margin: 0;
		padding: 0.25rem 0.75rem 0.25rem 0.625rem;
	}

	.kicker span {
		background-color: var(--ask-accent);
		border-radius: 50%;
		height: 0.375rem;
		width: 0.375rem;
	}

	h1 {
		color: var(--ask-text);
		font-family: var(--ask-font-display);
		font-size: clamp(2.375rem, 1.1rem + 4.4vw, 3.625rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.04;
		text-wrap: balance;
	}

	h1 :global(.home-hero-accent) {
		color: var(--ask-accent);
	}

	.tagline {
		color: var(--ask-text-muted);
		font-size: clamp(1rem, 0.9rem + 0.4vw, 1.1875rem);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.actions {
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.actions :global(.sl-link-button) {
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 600;
		gap: 0.5rem;
		margin: 0;
		padding: 0.625rem 1.125rem;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.actions :global(.sl-link-button.primary) {
		background-color: var(--ask-accent);
		border-color: var(--ask-accent);
		color: var(--ask-accent-contrast);
	}

	.actions :global(.sl-link-button.primary:hover) {
		background-color: var(--ask-accent-hover);
		border-color: var(--ask-accent-hover);
		color: var(--ask-accent-contrast);
	}

	.actions :global(.sl-link-button.secondary) {
		background-color: var(--ask-surface);
		border-color: var(--ask-border-strong);
		color: var(--ask-text);
	}

	.actions :global(.sl-link-button.secondary:hover) {
		background-color: var(--ask-surface-2);
		border-color: var(--ask-text-subtle);
		color: var(--ask-text);
	}

	.actions :global(.sl-link-button svg) {
		font-size: 1rem;
	}

	.art {
		margin-inline: auto;
		max-width: 27.5rem;
		width: 100%;
	}

	@media (min-width: 60rem) {
		.hero-home {
			gap: 4rem;
			grid-template-columns: minmax(0, 1fr) minmax(0, 27.5rem);
			padding-block: clamp(2.5rem, 7vh, 5rem) 3rem;
		}

		.hero-home .stack {
			align-items: flex-start;
			text-align: start;
		}

		.hero-home .copy {
			align-items: flex-start;
		}

		.hero-home .actions {
			justify-content: flex-start;
		}
	}
</style>
