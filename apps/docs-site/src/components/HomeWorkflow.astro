---
const steps = [
  {
    number: "01",
    title: "Init",
    body: "Run askdb init to scaffold askdb.config.ts. It holds your provider, database, and model settings, and you check it in like code.",
  },
  {
    number: "02",
    title: "Introspect",
    body: "AskDB reads your database (or a Prisma schema file) into a schema artifact: tables, columns, types, and relationships on disk.",
  },
  {
    number: "03",
    title: "Enrich",
    body: "In Studio, AskDB's local web app, add the descriptions, aliases, business concepts, and sensitive markers that make generation reliable. Test questions as you go.",
  },
  {
    number: "04",
    title: "Retrieve",
    body: "Optional, for a schema too large for one prompt. Index the schema artifact with @askdb/rag, and AskDB puts only the tables that matter to each question in the prompt.",
  },
  {
    number: "05",
    title: "Use",
    body: "Call ask() from your app, or POST to the HTTP API. AskDB returns checked SQL. Your application logs it, approves it, and runs it through your own pool.",
  },
];
---

<ol class="home-steps" aria-label="The five steps of using AskDB">
  {steps.map((step) => (
    <li class="home-step">
      <span class="home-step-number" aria-hidden="true">{step.number}</span>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </li>
  ))}
</ol>
