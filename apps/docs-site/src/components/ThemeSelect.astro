---
/**
 * The theme control: three buttons (light, dark, system) in one pill. It keeps Starlight's storage
 * key and `data-theme` attribute, so Starlight's inline theme script still sets the theme before
 * the first paint.
 */
import { Icon } from "@astrojs/starlight/components";

const t = Astro.locals.t;
const options = [
	{ theme: "light", icon: "sun", label: t("themeSelect.light") },
	{ theme: "dark", icon: "moon", label: t("themeSelect.dark") },
	{ theme: "auto", icon: "laptop", label: t("themeSelect.auto") },
] as const;
---

<starlight-theme-select>
	<div class="theme-control" role="group" aria-label={t("themeSelect.accessibleLabel")}>
		{
			options.map(({ theme, icon, label }) => (
				<button type="button" data-theme-option={theme} aria-pressed="false" aria-label={label} title={label}>
					<Icon name={icon} />
				</button>
			))
		}
	</div>
</starlight-theme-select>

<script>
	type Theme = "auto" | "dark" | "light";

	const storageKey = "starlight-theme";

	const parseTheme = (theme: unknown): Theme =>
		theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== "undefined" && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== "undefined") {
			localStorage.setItem(storageKey, theme === "light" || theme === "dark" ? theme : "");
		}
	}

	const preferredColorScheme = (): Theme =>
		matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

	/** Applies the theme to the page and marks the pressed button in every control. */
	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme === "auto" ? preferredColorScheme() : theme;
		document.querySelectorAll<HTMLButtonElement>("starlight-theme-select [data-theme-option]").forEach((button) => {
			button.setAttribute("aria-pressed", String(button.dataset.themeOption === theme));
		});
	}

	matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
		if (loadTheme() === "auto") applyTheme("auto");
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme());
			this.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((button) => {
				button.addEventListener("click", () => {
					const theme = parseTheme(button.dataset.themeOption);
					storeTheme(theme);
					applyTheme(theme);
				});
			});
		}
	}

	if (!customElements.get("starlight-theme-select")) {
		customElements.define("starlight-theme-select", StarlightThemeSelect);
	}
</script>

<style>
	.theme-control {
		background-color: var(--ask-surface);
		border: 1px solid var(--ask-border);
		border-radius: 999px;
		display: flex;
		gap: 0.125rem;
		padding: 0.1875rem;
	}

	button {
		align-items: center;
		background: transparent;
		border: 0;
		border-radius: 999px;
		color: var(--ask-text-subtle);
		cursor: pointer;
		display: flex;
		height: 1.625rem;
		justify-content: center;
		padding: 0;
		transition: color 0.12s ease, background-color 0.12s ease;
		width: 1.625rem;
	}

	button :global(svg) {
		font-size: 0.875rem;
	}

	button:hover {
		color: var(--ask-text);
	}

	button[aria-pressed="true"] {
		background-color: var(--ask-surface-2);
		box-shadow: 0 0 0 1px var(--ask-border);
		color: var(--ask-text);
	}
</style>
