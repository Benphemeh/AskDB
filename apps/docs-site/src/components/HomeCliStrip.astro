---
/**
 * The home page's install command: one line to copy, and where to go next. Rendered by the Hero
 * override, under the hero's actions.
 */
import { REPO_URL, withBase } from "../utils/links";

const installLine = "npx askdb init";
---

<section class="home-install" aria-labelledby="home-install-heading">
	<h2 id="home-install-heading" class="home-sr-only">Install AskDB</h2>
	<div class="home-install-command">
		<span class="home-install-prompt" aria-hidden="true">$</span>
		<code data-install-cmd>{installLine}</code>
		<button type="button" class="home-install-copy" aria-label="Copy the install command">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<rect x="9" y="9" width="11" height="11" rx="2.5"></rect>
				<path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"></path>
			</svg>
			<span data-copy-label>Copy</span>
		</button>
	</div>
	<p class="home-install-foot">
		Or <code>npm install askdb</code>
		<span aria-hidden="true">·</span>
		<a href={withBase("/install/")}>Install options</a>
		<span aria-hidden="true">·</span>
		<a href={REPO_URL}>GitHub</a>
	</p>
</section>

<script>
	document.addEventListener("click", async (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const button = target.closest(".home-install-copy");
		if (!(button instanceof HTMLButtonElement)) return;
		const command = button.closest(".home-install-command")?.querySelector("[data-install-cmd]")?.textContent?.trim();
		const label = button.querySelector("[data-copy-label]");
		if (!command || !label) return;
		try {
			await navigator.clipboard.writeText(command);
			label.textContent = "Copied";
			setTimeout(() => {
				label.textContent = "Copy";
			}, 1800);
		} catch {
			/* The clipboard may be denied; the command is still selectable. */
		}
	});
</script>
