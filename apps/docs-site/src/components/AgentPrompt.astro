---
/**
 * The "Use with your agent" block of a task guide: a prompt the reader copies and hands to a
 * coding agent. Put it under a `## Use with your agent` heading, before "Read next".
 *
 *   ## Use with your agent
 *
 *   <AgentPrompt>
 *   Add tenant scoping to this project's AskDB integration. Follow https://askdb.tools/guides/multi-tenancy.md.
 *
 *   Keep the database as the tenant boundary.
 *   </AgentPrompt>
 *
 * The slot is the prompt: plain text or Markdown paragraphs, lists, links and inline code. The copy
 * button copies it as plain text, with each link written out as its absolute URL. In the page's
 * Markdown twin and in /llms-full.txt the prompt is a blockquote under the heading.
 */
---

<section class="agent-prompt not-content" data-agent-prompt>
  <div class="agent-prompt-head">
    <p class="agent-prompt-hint">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path>
        <path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7z"></path>
      </svg>
      <span>To hand this task to a coding agent, copy the prompt and paste it into the agent.</span>
    </p>
    <button type="button" class="agent-prompt-copy" data-copy-prompt>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
        <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
      </svg>
      <span data-label aria-live="polite">Copy prompt</span>
    </button>
  </div>
  <blockquote class="agent-prompt-text" data-prompt tabindex="0"><slot /></blockquote>
</section>

<script>
  import { copyText, flashLabel, readableText } from "../utils/clipboard";

  for (const block of document.querySelectorAll<HTMLElement>("[data-agent-prompt]")) {
    const button = block.querySelector<HTMLButtonElement>("[data-copy-prompt]");
    const prompt = block.querySelector<HTMLElement>("[data-prompt]");
    if (!button || !prompt) continue;
    if (!navigator.clipboard) {
      button.hidden = true;
      continue;
    }
    button.addEventListener("click", async () => {
      try {
        await copyText(readableText(prompt));
        flashLabel(button, "Copied", "copied");
      } catch {
        flashLabel(button, "Couldn't copy", "failed");
      }
    });
  }
</script>

<style>
  .agent-prompt {
    background: var(--ask-surface-2);
    border: 1px solid var(--ask-border);
    border-radius: var(--ask-radius);
    margin-block: 1.5rem;
    padding: 1rem 1.125rem 1.125rem;
  }

  .agent-prompt-head {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .agent-prompt-hint {
    align-items: flex-start;
    color: var(--ask-text-muted);
    display: flex;
    flex: 1 1 16rem;
    font-size: 0.875rem;
    gap: 0.5rem;
    line-height: 1.55;
    margin: 0;
  }

  .agent-prompt-hint svg {
    color: var(--ask-accent);
    margin-top: 0.2rem;
  }

  .agent-prompt svg {
    fill: none;
    flex-shrink: 0;
    height: 1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    width: 1rem;
  }

  .agent-prompt-copy {
    align-items: center;
    background: var(--ask-surface);
    border: 1px solid var(--ask-border);
    border-radius: var(--ask-radius);
    color: var(--ask-text-muted);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 0.4rem;
    height: 2rem;
    line-height: 1;
    padding: 0 0.7rem;
    transition:
      border-color 0.12s ease,
      color 0.12s ease;
  }

  .agent-prompt-copy:hover,
  .agent-prompt-copy[data-state="copied"] {
    border-color: var(--ask-border-strong);
    color: var(--ask-text);
  }

  .agent-prompt-copy:focus-visible,
  .agent-prompt-text:focus-visible {
    outline: 2px solid var(--ask-accent);
    outline-offset: 2px;
  }

  .agent-prompt-text {
    background: var(--ask-surface);
    border: 1px solid var(--ask-border);
    border-radius: var(--ask-radius-sm);
    color: var(--ask-text);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.65;
    margin: 0;
    max-height: 18rem;
    overflow: auto;
    overflow-wrap: anywhere;
    padding: 0.85rem 1rem;
  }

  .agent-prompt-text :global(p),
  .agent-prompt-text :global(ul),
  .agent-prompt-text :global(ol) {
    margin: 0;
  }

  .agent-prompt-text :global(* + p),
  .agent-prompt-text :global(* + ul),
  .agent-prompt-text :global(* + ol) {
    margin-top: 0.75rem;
  }

  .agent-prompt-text :global(ul),
  .agent-prompt-text :global(ol) {
    padding-inline-start: 1.25rem;
  }

  .agent-prompt-text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--ask-accent);
    text-underline-offset: 0.2em;
  }

  .agent-prompt-text :global(code) {
    background: none;
    border: 0;
    font-size: inherit;
    padding: 0;
  }

  @media print {
    .agent-prompt-copy {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-prompt-copy {
      transition: none;
    }
  }
</style>
