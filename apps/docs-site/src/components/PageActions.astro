---
/**
 * The row of actions under a page's title: copy the page as Markdown, open it in an AI assistant,
 * view its Markdown. Rendered by overrides/PageTitle.astro.
 *
 * All three point at the page's Markdown twin (pages/[...slug].md.ts). Without JavaScript the copy
 * control is a link to the twin and the menu is a `<details>`, so both still work.
 */
import { assistantLinks, markdownPathFor } from "../utils/markdown-twin";

const { entry } = Astro.locals.starlightRoute;
// The home page (a splash page) and the 404 page have no page header to carry actions.
const show = entry.data.template !== "splash" && !entry.data.hero && entry.id !== "404";

const markdownPath = markdownPathFor(Astro.url.pathname, import.meta.env.BASE_URL);
const markdownUrl = new URL(markdownPath, Astro.site).href;
const links = assistantLinks(markdownUrl);
const primary = links.find((link) => link.id === "chatgpt")!;
---

{
  show && (
    <div class="page-actions print:hidden" data-page-actions data-pagefind-ignore>
      <a class="page-action" href={markdownPath} data-copy-markdown>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2" />
          <path d="M5 15V6a2 2 0 0 1 2-2h9" />
        </svg>
        <span data-label aria-live="polite">Copy as Markdown</span>
      </a>
      <div class="page-action-group">
        <a class="page-action" href={primary.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />
            <path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7z" />
          </svg>
          <span>{primary.label}</span>
        </a>
        <details class="page-action-menu">
          <summary class="page-action" aria-label="More ways to open this page">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  <span>{link.label}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
              </li>
            ))}
            <li class="page-action-menu-rule">
              <a href={markdownPath}>
                <span>View as Markdown</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                  <path d="M14 3v5h5" />
                </svg>
              </a>
            </li>
          </ul>
        </details>
      </div>
    </div>
  )
}

<script>
  import { copyText, flashLabel } from "../utils/clipboard";

  for (const actions of document.querySelectorAll<HTMLElement>("[data-page-actions]")) {
    const copy = actions.querySelector<HTMLAnchorElement>("[data-copy-markdown]");
    if (copy && navigator.clipboard) {
      // With JavaScript the link is a button that copies. Without it, it opens the Markdown.
      copy.setAttribute("role", "button");
      const run = async () => {
        try {
          await copyText(
            fetch(copy.href).then((response) => {
              if (!response.ok) throw new Error(`${response.status}`);
              return response.text();
            }),
          );
          flashLabel(copy, "Copied", "copied");
        } catch {
          flashLabel(copy, "Couldn't copy", "failed");
        }
      };
      copy.addEventListener("click", (event) => {
        // A modified click (new tab, download) keeps the link's own behaviour.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        void run();
      });
      copy.addEventListener("keydown", (event) => {
        if (event.key !== " ") return;
        event.preventDefault();
        void run();
      });
    }

    const menu = actions.querySelector<HTMLDetailsElement>("details.page-action-menu");
    const summary = menu?.querySelector<HTMLElement>("summary");
    if (!menu || !summary) continue;
    const close = (refocus: boolean) => {
      if (!menu.open) return;
      menu.open = false;
      if (refocus) summary.focus();
    };
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) close(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close(menu.contains(document.activeElement));
    });
    menu.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) close(false);
    });
    for (const link of menu.querySelectorAll("a")) link.addEventListener("click", () => close(false));
  }
</script>

<style>
  .page-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .page-action {
    align-items: center;
    background: var(--ask-surface);
    border: 1px solid var(--ask-border);
    border-radius: var(--ask-radius);
    color: var(--ask-text-muted);
    cursor: pointer;
    display: inline-flex;
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 0.4rem;
    height: 2rem;
    line-height: 1;
    padding: 0 0.7rem;
    text-decoration: none;
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease;
    user-select: none;
    white-space: nowrap;
  }

  .page-action:hover,
  .page-action-menu[open] > summary {
    background: var(--ask-surface-2);
    border-color: var(--ask-border-strong);
    color: var(--ask-text);
  }

  .page-action:focus-visible,
  .page-action-menu a:focus-visible {
    outline: 2px solid var(--ask-accent);
    outline-offset: 2px;
  }

  .page-action[data-state="copied"] {
    border-color: var(--ask-border-strong);
    color: var(--ask-text);
  }

  .page-action svg,
  .page-action-menu a svg {
    fill: none;
    flex-shrink: 0;
    height: 0.95rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    width: 0.95rem;
  }

  /* The split button: the link and the menu's toggle share one border. */
  .page-action-group {
    display: inline-flex;
    position: relative;
  }

  .page-action-group > .page-action {
    border-end-end-radius: 0;
    border-start-end-radius: 0;
  }

  .page-action-menu > summary {
    border-end-start-radius: 0;
    border-inline-start-width: 0;
    border-start-start-radius: 0;
    list-style: none;
    padding: 0 0.45rem;
  }

  .page-action-menu > summary::-webkit-details-marker {
    display: none;
  }

  .page-action-menu[open] > summary svg {
    transform: rotate(180deg);
  }

  .page-action-menu ul {
    background: var(--ask-surface);
    border: 1px solid var(--ask-border);
    border-radius: var(--ask-radius);
    box-shadow: var(--ask-shadow-pop);
    inset-block-start: calc(100% + 0.375rem);
    inset-inline-start: 0;
    list-style: none;
    margin: 0;
    min-width: 13.5rem;
    padding: 0.25rem;
    position: absolute;
    z-index: 10;
  }

  .page-action-menu li {
    margin: 0;
    padding: 0;
  }

  .page-action-menu-rule {
    border-top: 1px solid var(--ask-border);
    margin-top: 0.25rem !important;
    padding-top: 0.25rem !important;
  }

  .page-action-menu a {
    align-items: center;
    border-radius: var(--ask-radius-sm);
    color: var(--ask-text-muted);
    display: flex;
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.45rem 0.6rem;
    text-decoration: none;
  }

  .page-action-menu a:hover {
    background: var(--ask-surface-2);
    color: var(--ask-text);
  }

  .page-action-menu a svg {
    color: var(--ask-text-subtle);
  }

  /* On a phone, tighten the buttons so both fit on one row. */
  @media (max-width: 26rem) {
    .page-actions {
      gap: 0.375rem;
    }

    .page-action {
      font-size: 0.78rem;
      gap: 0.3rem;
      padding: 0 0.5rem;
    }

    .page-action-menu > summary {
      padding: 0 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-action {
      transition: none;
    }
  }
</style>
